<Window x:Class="QingJie.Capture.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cap="clr-namespace:QingJie.Capture"
        Title="轻截"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" WindowStartupLocation="Manual"
        Background="#000000" Cursor="Cross"
        UseLayoutRounding="True" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12"
        Focusable="True" ShowActivated="True"
        InputMethod.IsInputMethodEnabled="False">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#F51C1F26" />
        <SolidColorBrush x:Key="PanelBorder" Color="#3AFFFFFF" />
        <SolidColorBrush x:Key="Accent" Color="#2E7CF6" />
        <SolidColorBrush x:Key="IconStroke" Color="#E9ECF1" />

        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="Stroke" Value="{StaticResource IconStroke}" />
            <Setter Property="StrokeThickness" Value="1.7" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
        </Style>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A2E7CF6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SeparatorLine" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Fill" Value="#2EFFFFFF" />
            <Setter Property="Margin" Value="5,0" />
        </Style>

        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Padding" Value="11,4" />
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="Foreground" Value="#E9ECF1" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3DFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#59FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="Black" ClipToBounds="True"
          MouseMove="Root_MouseMove"
          MouseLeftButtonDown="Root_MouseLeftButtonDown"
          MouseLeftButtonUp="Root_MouseLeftButtonUp"
          MouseRightButtonDown="Root_MouseRightButtonDown">

        <!-- 截图底图：1:1 铺满窗口 -->
        <Image x:Name="BackImage" Stretch="Fill" IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="NearestNeighbor" />

        <Canvas x:Name="Layer">
            <!-- 遮罩 -->
            <Rectangle x:Name="MaskFull" Fill="#8C000000" IsHitTestVisible="False" />
            <Rectangle x:Name="MaskTop" Fill="#8C000000" IsHitTestVisible="False" Visibility="Collapsed" />
            <Rectangle x:Name="MaskLeft" Fill="#8C000000" IsHitTestVisible="False" Visibility="Collapsed" />
            <Rectangle x:Name="MaskRight" Fill="#8C000000" IsHitTestVisible="False" Visibility="Collapsed" />
            <Rectangle x:Name="MaskBottom" Fill="#8C000000" IsHitTestVisible="False" Visibility="Collapsed" />

            <!-- 选区 -->
            <Border x:Name="SelectionBorder" Visibility="Collapsed" IsHitTestVisible="False"
                    BorderBrush="#FF2E7CF6" BorderThickness="1.2" />

            <!-- 标注预览层 -->
            <cap:AnnotationLayer x:Name="AnnoLayer" Visibility="Collapsed" />

            <!-- 控制点 -->
            <Canvas x:Name="HandleLayer" IsHitTestVisible="False" Visibility="Collapsed" />

            <!-- 尺寸标签 -->
            <Border x:Name="SizeLabel" Visibility="Collapsed" IsHitTestVisible="False"
                    Background="#F01C1F26" CornerRadius="4" Padding="7,3" BorderBrush="#3AFFFFFF" BorderThickness="1">
                <TextBlock x:Name="SizeText" Foreground="#FFFFFF" FontSize="11.5" />
            </Border>

            <!-- 放大镜 -->
            <Border x:Name="Magnifier" Visibility="Collapsed" IsHitTestVisible="False"
                    Background="#F51C1F26" BorderBrush="#45FFFFFF" BorderThickness="1"
                    CornerRadius="8" Padding="6">
                <StackPanel>
                    <Border Width="132" Height="92" ClipToBounds="True" CornerRadius="4" Background="#000000">
                        <Grid>
                            <Image x:Name="LoupeImage" Stretch="Fill"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            <Rectangle Width="1" Height="15" Fill="#FF5252" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Rectangle Height="1" Width="15" Fill="#FF5252" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border BorderBrush="#55FFFFFF" BorderThickness="1" />
                        </Grid>
                    </Border>
                    <Grid Margin="2,6,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ColorChip" Width="15" Height="15" CornerRadius="3"
                                BorderBrush="#66FFFFFF" BorderThickness="1" Background="#FF000000"
                                VerticalAlignment="Center" />
                        <TextBlock x:Name="LoupeInfo" Grid.Column="1" Margin="7,0,0,0"
                                   Foreground="#E9ECF1" FontSize="11.5" VerticalAlignment="Center"
                                   FontFamily="Consolas, Microsoft YaHei UI" />
                    </Grid>
                    <TextBlock x:Name="LoupeSize" Margin="2,3,2,0" Foreground="#9BA1AC" FontSize="10.5"
                               FontFamily="Consolas, Microsoft YaHei UI" />
                </StackPanel>
            </Border>

            <!-- 顶部提示 -->
            <Border x:Name="HintPanel" IsHitTestVisible="False" Background="#B0000000"
                    CornerRadius="14" Padding="14,7">
                <TextBlock x:Name="HintText" Foreground="#F0F2F5" FontSize="12.5"
                           Text="拖拽选择区域　·　回车复制　·　X 识别文字　·　Ctrl+S 保存　·　Esc 退出" />
            </Border>

            <!-- 工具栏 -->
            <Border x:Name="Toolbar" Visibility="Collapsed" Background="{StaticResource PanelBg}"
                    BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                    CornerRadius="9" Padding="5" VerticalAlignment="Top" HorizontalAlignment="Left">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.35" Color="#000000" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="ToolRectangle" Style="{StaticResource ToolToggle}" Tag="Rectangle"
                                  ToolTip="矩形 (R)" Click="ToolButton_Click">
                        <Path Style="{StaticResource IconPath}"
                              Data="M3.5,5.5 H16.5 V14.5 H3.5 Z" />
                    </ToggleButton>
                    <ToggleButton x:Name="ToolEllipse" Style="{StaticResource ToolToggle}" Tag="Ellipse"
                                  ToolTip="椭圆 (O)" Click="ToolButton_Click">
                        <Path Style="{StaticResource IconPath}"
                              Data="M3,10 A7,4.6 0 1 1 17,10 A7,4.6 0 1 1 3,10 Z" />
                    </ToggleButton>
                    <ToggleButton x:Name="ToolArrow" Style="{StaticResource ToolToggle}" Tag="Arrow"
                                  ToolTip="箭头 (A)" Click="ToolButton_Click">
                        <Path Style="{StaticResource IconPath}"
                              Data="M4.6,15.4 L15.4,4.6 M15.4,4.6 H9.4 M15.4,4.6 V10.6" />
                    </ToggleButton>
                    <ToggleButton x:Name="ToolPen" Style="{StaticResource ToolToggle}" Tag="Pen"
                                  ToolTip="画笔 (P)" Click="ToolButton_Click">
                        <Path Style="{StaticResource IconPath}"
                              Data="M13.1,3.7 L16.3,6.9 L7.1,16.1 L3.4,16.6 L3.9,12.9 Z" />
                    </ToggleButton>
                    <ToggleButton x:Name="ToolText" Style="{StaticResource ToolToggle}" Tag="Text"
                                  ToolTip="文字 (T)" Click="ToolButton_Click">
                        <Path Style="{StaticResource IconPath}" Data="M5,5 H15 M10,5 V15.5" />
                    </ToggleButton>
                    <ToggleButton x:Name="ToolMosaic" Style="{StaticResource ToolToggle}" Tag="Mosaic"
                                  ToolTip="马赛克 (M)" Click="ToolButton_Click">
                        <Path Style="{StaticResource IconPath}"
                              Data="M3.5,3.5 h5.4 v5.4 h-5.4 z M11.1,3.5 h5.4 v5.4 h-5.4 z M3.5,11.1 h5.4 v5.4 h-5.4 z M11.1,11.1 h5.4 v5.4 h-5.4 z" />
                    </ToggleButton>

                    <Button x:Name="OcrButton" Style="{StaticResource ToolButton}" ToolTip="识别文字 (X)"
                            Click="OcrButton_Click">
                        <Path Style="{StaticResource IconPath}"
                              Data="M3.4,4.6 H16.6 V15.4 H3.4 Z M6.6,8.5 H13.4 M6.6,11 H13.4 M6.6,13.5 H10.6" />
                    </Button>

                    <Rectangle Style="{StaticResource SeparatorLine}" />

                    <Button x:Name="StyleButton" Style="{StaticResource ToolButton}" ToolTip="颜色与线条粗细"
                            Click="StyleButton_Click">
                        <Grid Width="20" Height="20">
                            <Ellipse x:Name="ColorDot" Width="13" Height="13" Stroke="#FFFFFF" StrokeThickness="1.4" />
                        </Grid>
                    </Button>

                    <Button x:Name="UndoButton" Style="{StaticResource ToolButton}" ToolTip="撤销 (Ctrl+Z)"
                            Click="UndoButton_Click">
                        <Path Style="{StaticResource IconPath}"
                              Data="M7.4,7 L3.8,10.6 L7.4,14.2 M3.8,10.6 H12.2 A3.9,3.9 0 0 1 12.2,18.4 H10" />
                    </Button>

                    <Rectangle Style="{StaticResource SeparatorLine}" />

                    <Button x:Name="SaveButton" Style="{StaticResource ToolButton}" ToolTip="保存 (Ctrl+S)"
                            Click="SaveButton_Click">
                        <Path Style="{StaticResource IconPath}"
                              Data="M10,3.6 V11.8 M6.6,8.4 L10,11.8 L13.4,8.4 M4,16.4 H16" />
                    </Button>
                    <Button x:Name="CopyButton" Background="{StaticResource Accent}" ToolTip="复制到剪贴板 (Enter)"
                            Style="{StaticResource ToolButton}" Click="CopyButton_Click">
                        <Path Style="{StaticResource IconPath}"
                              Data="M7.2,7.2 H15.8 V15.8 H7.2 Z M12.8,4.2 H4.2 V12.8" />
                    </Button>
                    <Button x:Name="PinButton" Style="{StaticResource ToolButton}" ToolTip="钉在屏幕上 (Ctrl+P)"
                            Click="PinButton_Click">
                        <Path Data="M15.6,11.6 V4.4 H16.6 V2.6 H7.4 V4.4 H8.4 V11.6 L6.4,13.6 V15.4 H11.2 V20.8 H12.8 V15.4 H17.6 V13.6 Z"
                              Width="17" Height="19" Stretch="Uniform" Stroke="#E9ECF1" StrokeThickness="1.9"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Fill="Transparent" />
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource ToolButton}" ToolTip="退出 (Esc)"
                            Click="CloseButton_Click">
                        <Path Style="{StaticResource IconPath}" Data="M5.6,5.6 L14.4,14.4 M14.4,5.6 L5.6,14.4" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- 取字结果面板 -->
            <Border x:Name="OcrPanel" Visibility="Collapsed" Width="380"
                    Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1" CornerRadius="9" Padding="12,10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.35" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <Grid>
                        <TextBlock Text="识别结果" Foreground="#9BA1AC" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock x:Name="OcrStatus" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="#7FD6A0" FontSize="11" />
                    </Grid>
                    <TextBox x:Name="OcrText" Margin="0,7,0,0" MinHeight="78" MaxHeight="200"
                             Background="#33000000" BorderBrush="#3AFFFFFF" BorderThickness="1"
                             Foreground="#E9ECF1" CaretBrush="#FFFFFF" FontSize="12.5" Padding="6,5"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             InputMethod.IsInputMethodEnabled="True" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,9,0,0">
                        <Button x:Name="OcrCopyButton" Content="复制文字" Style="{StaticResource TextButton}"
                                Click="OcrCopyButton_Click" />
                        <Button Content="关闭" Style="{StaticResource TextButton}" Margin="8,0,0,0"
                                Click="OcrCloseButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 颜色 / 粗细 弹出面板 -->
            <Popup x:Name="StylePopup" AllowsTransparency="True" StaysOpen="False"
                   Placement="Top" PlacementTarget="{Binding ElementName=StyleButton}"
                   PopupAnimation="Fade" VerticalOffset="-8">
                <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="10">
                    <StackPanel>
                        <TextBlock Text="颜色" Foreground="#9BA1AC" FontSize="11" Margin="2,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource ToolButton}" Background="#FF3B30" Tag="#FF3B30" Click="ColorButton_Click" ToolTip="红">
                                <Ellipse Width="15" Height="15" Fill="#FF3B30" />
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Tag="#FF9500" Click="ColorButton_Click" ToolTip="橙">
                                <Ellipse Width="15" Height="15" Fill="#FF9500" />
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Tag="#FFD60A" Click="ColorButton_Click" ToolTip="黄">
                                <Ellipse Width="15" Height="15" Fill="#FFD60A" />
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Tag="#32D74B" Click="ColorButton_Click" ToolTip="绿">
                                <Ellipse Width="15" Height="15" Fill="#32D74B" />
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Tag="#2E7CF6" Click="ColorButton_Click" ToolTip="蓝">
                                <Ellipse Width="15" Height="15" Fill="#2E7CF6" />
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Tag="#FFFFFF" Click="ColorButton_Click" ToolTip="白">
                                <Ellipse Width="15" Height="15" Fill="#FFFFFF" />
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Tag="#000000" Click="ColorButton_Click" ToolTip="黑">
                                <Ellipse Width="15" Height="15" Fill="#000000" Stroke="#66FFFFFF" StrokeThickness="1" />
                            </Button>
                        </StackPanel>
                        <TextBlock Text="线条粗细" Foreground="#9BA1AC" FontSize="11" Margin="2,10,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource ToolButton}" Tag="2" Click="ThicknessButton_Click" ToolTip="细">
                                <Rectangle Width="16" Height="2" Fill="#E9ECF1" RadiusX="1" RadiusY="1" />
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Tag="4" Click="ThicknessButton_Click" ToolTip="中">
                                <Rectangle Width="16" Height="4" Fill="#E9ECF1" RadiusX="2" RadiusY="2" />
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Tag="7" Click="ThicknessButton_Click" ToolTip="粗">
                                <Rectangle Width="16" Height="7" Fill="#E9ECF1" RadiusX="3" RadiusY="3" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- 文字输入框 -->
            <TextBox x:Name="TextEditor" Visibility="Collapsed" MinWidth="90" Padding="2,1"
                     Background="#33000000" BorderBrush="#FF2E7CF6" BorderThickness="1"
                     Foreground="#FF3B30" CaretBrush="#FFFFFF" FontSize="16"
                     AcceptsReturn="True" TextWrapping="NoWrap"
                     InputMethod.IsInputMethodEnabled="True"
                     PreviewKeyDown="TextEditor_PreviewKeyDown" LostFocus="TextEditor_LostFocus" />
        </Canvas>
    </Grid>
</Window>
