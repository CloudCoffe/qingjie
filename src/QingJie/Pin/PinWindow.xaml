<Window x:Class="QingJie.Pin.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="轻截贴图"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" WindowStartupLocation="Manual" Background="Transparent"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12"
        Cursor="SizeAll" SnapsToDevicePixels="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseWheel="Window_MouseWheel"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#F51C1F26" />
            <Setter Property="Foreground" Value="#E9ECF1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#3AFFFFFF"
                                BorderThickness="1" CornerRadius="9" Padding="3">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.35" Color="#000000" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E9ECF1" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="11,7" Margin="0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Check" Text="✓" Foreground="#2E7CF6" FontSize="11"
                                           Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Hidden" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"
                                                  RecognizesAccessKey="False" />
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                           Foreground="#7E858F" FontSize="11" Margin="22,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Rectangle Height="1" Fill="#26FFFFFF" Margin="8,4" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="MenuCopy" Header="复制图片" InputGestureText="Ctrl+C" Click="MenuCopy_Click" />
            <MenuItem x:Name="MenuSave" Header="另存为…" InputGestureText="Ctrl+S" Click="MenuSave_Click" />
            <Separator />
            <MenuItem x:Name="MenuTopmost" Header="窗口置顶" IsCheckable="True" IsChecked="True" Click="MenuTopmost_Click" />
            <MenuItem x:Name="MenuResetZoom" Header="恢复原始大小" InputGestureText="滚轮缩放" Click="MenuResetZoom_Click" />
            <Separator />
            <MenuItem x:Name="MenuClose" Header="关闭贴图" InputGestureText="Esc" Click="MenuClose_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid x:Name="Frame">
        <Image x:Name="Preview" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
        <!-- 1px 描边叠在图片上，不侵占图片像素 -->
        <Border BorderBrush="#552E7CF6" BorderThickness="1" Background="Transparent" IsHitTestVisible="False" />
    </Grid>
</Window>
