<Window x:Class="QingJie.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="轻截 · 设置"
        Width="470" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12.5"
        UseLayoutRounding="True">

    <Border Background="{StaticResource WindowBg}" CornerRadius="12" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.45" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="22,16,0,0">
                    <TextBlock Text="轻截" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="设置" FontSize="15" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0"
                        Width="30" Height="30" Click="Close_Click" Cursor="Hand"
                        Background="Transparent" BorderThickness="0" ToolTip="关闭">
                    <Path Data="M4,4 L12,12 M12,4 L4,12" Stroke="#9BA1AC" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" />
                </Button>
            </Grid>

            <!-- 表单 -->
            <StackPanel Grid.Row="1" Margin="22,18,22,0">
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="截图快捷键" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                    <TextBox x:Name="HotkeyBox" Grid.Column="1" Padding="9,6" IsReadOnly="True" Cursor="Hand"
                             Background="{StaticResource CardBg}" Foreground="{StaticResource TextPrimary}"
                             BorderBrush="#33FFFFFF" BorderThickness="1" CaretBrush="Transparent"
                             PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotFocus="HotkeyBox_GotFocus"
                             ToolTip="点击后直接按下想要的组合键，例如 Ctrl+Alt+A" />
                </Grid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="保存目录" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                    <TextBox x:Name="SaveDirBox" Grid.Column="1" Padding="9,6"
                             Background="{StaticResource CardBg}" Foreground="{StaticResource TextPrimary}"
                             BorderBrush="#33FFFFFF" BorderThickness="1" />
                    <Button Grid.Column="2" Content="浏览…" Margin="8,0,0,0" Padding="12,6"
                            Style="{StaticResource GhostButton}" Click="Browse_Click" />
                </Grid>

                <StackPanel Margin="104,0,0,12">
                    <CheckBox x:Name="CopyCheck" Content="复制时写入剪贴板" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,10" />
                    <CheckBox x:Name="AskPathCheck" Content="保存时询问文件路径" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10" />
                    <CheckBox x:Name="MagnifierCheck" Content="显示放大镜与取色信息" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10" />
                    <CheckBox x:Name="CloseAfterCopyCheck" Content="复制后自动关闭截图界面" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10" />
                    <CheckBox x:Name="BallCheck" Content="显示桌面悬浮球（点一下即截图）" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10" />
                    <CheckBox x:Name="StartupCheck" Content="开机自动启动" Foreground="{StaticResource TextPrimary}" />
                </StackPanel>

                <TextBlock x:Name="HintText" Foreground="#7E858F" FontSize="11.5" Margin="0,4,0,0"
                           Text="提示：滚轮缩放贴图，Ctrl + 滚轮调整透明度，Esc 关闭贴图。" TextWrapping="Wrap" />
            </StackPanel>

            <!-- 底部按钮 -->
            <Grid Grid.Row="2" Margin="22,20,22,18">
                <TextBlock x:Name="VersionText" Foreground="#666C75" FontSize="11" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="Cancel_Click" />
                    <Button Content="保存" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
